{
  "manifest_version": 3,
  "name": "StyleSnatch Pro",
  "version": "3.1",
  "description": "Hover to inspect and copy CSS, HTML, Tailwind, SVG icons, and images with Alt+Shift+S.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle StyleSnatch Element Inspector"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["json_viewer.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}